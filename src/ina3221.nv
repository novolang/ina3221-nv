// ina3221 — Texas Instruments' INA3221 three-channel current and voltage
// monitor, on its I2C bus, as devices-nv's `CurrentMonitor` for three
// channels and `Identifiable`.
//
// The facts below are from the data sheet "INA3221 26V, Triple Channel,
// 13-Bit, I2C Output Current and Voltage Monitor With Alerts", Texas
// Instruments, SBOS576C, May 2012, revised September 2026; the sections,
// tables and registers named are that sheet's.  Where the sheet and the
// drivers read for this one disagree, the site says which was taken.
//
// Each of three channels has a shunt resistor in series with its load.  The
// part measures the small voltage across each shunt (the shunt voltage) and
// the voltage at the IN- pin of each channel (the bus voltage).  It has no
// calibration register and does not know the resistances: the current is
// the shunt voltage over the resistance, which this driver computes from the
// resistances given at `attach`.
//
// The registers (Table 8-1), all 16 bits, the high byte first:
//
//   0x00  CONFIG        RST (15), CH1en to CH3en (14 to 12), AVG (11:9),
//                       VBUSCT (8:6), VSHCT (5:3), MODE (2:0); POR 0x7127
//   0x01, 0x03, 0x05  SHUNT of channel 1 to 3: a signed 13-bit value in
//                       bits 15 to 3, 40 uV per step, full scale 163.8 mV
//   0x02, 0x04, 0x06  BUS of channel 1 to 3: the same layout, 8 mV per step
//   0x07, 0x09, 0x0B  CRITICAL limit of channel 1 to 3, the shunt layout
//   0x08, 0x0A, 0x0C  WARNING limit of channel 1 to 3, the shunt layout
//   0x0D  SUM           the sum of the shunt voltages of the channels the
//                       summation control picks: signed, bits 15 to 1, 40 uV
//   0x0E  SUM LIMIT     the same layout, POR 0x7FFE
//   0x0F  MASK/ENABLE   SCC1 to SCC3 (14 to 12), WEN (11), CEN (10), CF1 to
//                       CF3 (9 to 7), SF (6), WF1 to WF3 (5 to 3), PVF (2),
//                       TCF (1), CVRF (0); POR 0x0002
//   0x10  PV UPPER      power-valid upper limit, 8 mV per step, POR 0x2710
//   0x11  PV LOWER      power-valid lower limit, POR 0x2328
//   0xFE  MANUFACTURER  0x5449
//   0xFF  DIE ID        0x3220
//
// Fix kept: a shunt or bus register is a 13-bit signed number in the upper
// bits, so the driver sign-extends the whole register and shifts it right,
// arithmetically.  Zephyr's `drivers/sensor/ti/ina3221` shifts the unsigned
// register right by 3 first, which turns a negative shunt voltage (a
// charging battery) into a large positive one; the `ina3221` crate 0.4.5
// negates and shifts the register as an unsigned number and does the same.
//
// Fix kept: the CONFIG register holds the channel enables, the averaging,
// both conversion times and the mode together, and the driver changes one
// field by reading the register and writing it back with that field
// replaced.  The crate's `set_channels_enabled` masks the register with
// 0xFFF8, which clears the mode and so powers the part down, and drops the
// averaging and the conversion times it writes over.
//
// Fix kept: the alert flags of MASK/ENABLE (Table 8-33) number the channels
// downward in the register, CF1 at bit 9 and CF3 at bit 7, WF1 at bit 5 and
// WF3 at bit 3, SCC1 at bit 14 and SCC3 at bit 12.  The crate's flag set
// numbers the warning, critical and summation flags the other way (its
// first warning flag is bit 3, the sheet's WF3).  This driver follows the
// sheet and reports a channel by its number, 0 to 2.
//
// Fix kept: reading MASK/ENABLE clears the flags it holds (Section 8.2.16),
// and a write to it does not clear them.  The driver writes only the six
// configuration bits, reads it back under that mask, and has one function
// that returns the flags it read.  Writing CONFIG clears the Conversion Ready
// flag too (Section 7.3.1), so a triggered conversion is started by that
// write and the flag is polled afterwards.
//
// Fix kept: a triggered conversion measures every enabled channel once, so it
// takes the number of enabled channels times the averages times the
// conversion times of the signals the mode measures (Section 7.4.2.1; Zephyr
// computes the same product).  A part with no channel enabled has nothing to
// convert, and `convert_start` answers -1.
//
// Fix kept: the part reads one register per transaction.  The sheet defines
// a read as the pointer write and two bytes, "read data are from the last
// register pointer location" (Figure 7-11), and says nothing of a pointer
// that advances; a reading is therefore a CONFIG read, a shunt read and a bus
// read for a channel.  devices-nv's reference double lets a read run on into
// the next register, which the sheet does not promise.
//
// The saturation of the shunt ADC is reported as the trait's `overflow`.
// The part has no math overflow flag, since it computes no current; a shunt
// register at its positive or negative full scale (4095 or -4096 steps)
// cannot be told from a voltage past it, so the reading sets `overflow` and
// answers a current and a power of 0.
//
// The address (Table 7-1) is 0x40 + A0 with the pin 0 for GND, 1 for VS, 2
// for SDA and 3 for SCL.  The part has four alert pins: Critical, Warning,
// Power Valid and Timing Control.  The wiring's `irq` is the Critical pin;
// a program that uses the others reads them with its own GPIO.
//
// A bus enters through `Ina3221Port`, which a type that holds a bus
// implements: `Ina3221I2c`.  The framing is `i2c_read_into` and `i2c_write`,
// generic over `I2cBus`, so a test runs them over a double of the bus.

use embedded_hal.{ BoardI2c, BoardGpio, I2cBus, GpioOut }
use dev_bus.{ DeviceWiring, DevBytes }
use dev_power.{ MilliVolts }
use dev_current.{ MicroVolts, MicroAmps, MicroWatts, MonReading, CurrentMonitor }
use dev_id.{ DeviceId, Identifiable }

// The registers (Table 8-1).  The registers of channel `ch` are 2 * ch past
// the first of each kind.
let REG_CONFIG    = 0x00
let REG_SHUNT1    = 0x01
let REG_BUS1      = 0x02
let REG_CRIT1     = 0x07
let REG_WARN1     = 0x08
let REG_SUM       = 0x0D
let REG_SUM_LIMIT = 0x0E
let REG_MASK      = 0x0F
let REG_PV_UPPER  = 0x10
let REG_PV_LOWER  = 0x11
let REG_MANUF     = 0xFE
let REG_DIE       = 0xFF

// The manufacturer ID register's value: "TI".
pub const MANUFACTURER_ID = 0x5449

// The die ID register's value.
pub const DIE_ID = 0x3220

// CONFIG: the reset bit.
let CFG_RST = 0x8000

// The power-on value of CONFIG: all three channels enabled, one average,
// 1.1 ms conversions, continuous shunt and bus.
pub const CONFIG_POR = 0x7127

// The power-on value of MASK/ENABLE: the timing-control flag reads 1.
pub const MASK_POR = 0x0002

// MASK/ENABLE: the bits a program configures (SCC1 to SCC3, WEN, CEN).
let ME_CONFIG_MASK = 0x7C00
let ME_WEN         = 0x0800
let ME_CEN         = 0x0400

// The largest shunt voltage the part measures, in microvolts: 4095 steps of
// 40 uV (a register of 0x7FF8).
pub const SHUNT_FULL_SCALE_UV = 163800

// The most negative shunt voltage, 4096 steps of 40 uV below zero.
pub const SHUNT_FLOOR_UV = -163840

// The clock `setup` asks for: I2C fast mode.
let I2C_HZ = 400000

// The operating modes of CONFIG.MODE (Table 8-4).  Triggered modes convert
// the enabled channels once when CONFIG is written and then power down;
// continuous modes convert until told not to.
pub const MODE_POWER_DOWN = 0

// Triggered, the shunt voltages only.
pub const MODE_SHUNT_TRIGGERED = 1

// Triggered, the bus voltages only.
pub const MODE_BUS_TRIGGERED = 2

// Triggered, the shunt and the bus voltages.
pub const MODE_BOTH_TRIGGERED = 3

// Continuous, the shunt voltages only.
pub const MODE_SHUNT_CONTINUOUS = 5

// Continuous, the bus voltages only.
pub const MODE_BUS_CONTINUOUS = 6

// Continuous, the shunt and the bus voltages; the power-on mode.
pub const MODE_BOTH_CONTINUOUS = 7

// The CONFIG fields as codes.  `channels` is a mask, bit 0 for channel 0 (the
// sheet's channel 1) to bit 2; `avg` 0 to 7 for 1, 4, 16, 64, 128, 256, 512
// and 1024 averages; `vbus_ct` and `vshunt_ct` 0 to 7 for 140, 204, 332, 588,
// 1100, 2116, 4156 and 8244 microseconds; `mode` 0 to 7 as above.
pub @value
struct Ina3221Config
    channels: Int
    avg: Int
    vbus_ct: Int
    vshunt_ct: Int
    mode: Int

// The flags of MASK/ENABLE as they were when it was read.  `critical` and
// `warning` are masks with bit 0 for channel 0; `sum` is the summation alert
// flag; `power_valid` follows the PV pin and `timing` the TC pin; `ready` is
// Conversion Ready.
pub @value
struct Ina3221Flags
    critical: Int
    warning: Int
    sum: Bool
    power_valid: Bool
    timing: Bool
    ready: Bool

// What MASK/ENABLE configures: the channels whose shunt voltages the sum
// register adds (a mask, bit 0 for channel 0) and whether the Warning and
// Critical alerts latch until MASK/ENABLE is read.
pub @value
struct Ina3221Alert
    sum_channels: Int
    warning_latch: Bool
    critical_latch: Bool

// A bus the part is on.  `setup` makes the bus ready and the Critical pin an
// input and answers whether the wiring suits it; `read_regs` reads `n` bytes
// from the register `reg` in one transaction; `write_regs` writes the bytes
// of `src` from `reg` in one transaction; `alert_level` answers the level of
// the Critical pin, -1 for a wiring with none.
pub trait Ina3221Port
    fn setup(self) -> Bool [hw]
    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
    fn write_regs(self, reg: Int, src: DevBytes) -> Bool [hw]
    fn alert_level(self) -> Int [hw]

// ── The bus ──────────────────────────────────────────────────────────

// Reads `n` bytes from the register `reg` into `dst` in one I2C
// transaction, a write of the pointer and a repeated start: whether the
// part answered.
pub fn i2c_read_into<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, n: Int,
                                var dst: DevBytes) -> Bool [hw]
    dev_bus.wiring_read_into(bus, w, reg, n, var dst)

// Writes the bytes of `src` to the register `reg` in one I2C transaction:
// whether the part acknowledged.
pub fn i2c_write<B: I2cBus>(bus: B, w: DeviceWiring, reg: Int, src: DevBytes) -> Bool [hw]
    dev_bus.wiring_write_from(bus, w, reg, src)

// Makes the I2C bus ready: the Critical pin an input, the bus at 400 kHz.
// Answers whether the wiring has an address.  The alert pins are open-drain
// and need a pull-up on the board.
pub fn i2c_setup<B: I2cBus, G: GpioOut>(bus: B, gpio: G, w: DeviceWiring) -> Bool [hw]
    if let Some(alert) = w.irq
        gpio.mode(alert, 0)
    bus.init(I2C_HZ)
    w.addr != None

// The level of the part's Critical pin on the board, 1 or 0, or -1 for a
// wiring with no pin.  The pin is active low.
pub fn alert_level_of<G: GpioOut>(gpio: G, w: DeviceWiring) -> Int [hw]
    let Some(alert) = w.irq else return -1
    gpio.get(alert)

// The I2C address for the pin A0, 0 for GND, 1 for VS, 2 for SDA and 3 for
// SCL (Table 7-1): 0x40 to 0x43, or -1 for a pin outside 0 to 3.
//
// ```novo
// use ina3221
//
// fn main() [io]
//     println("${ina3221.address_of(0)} ${ina3221.address_of(3)}")   // 64 67
// ```
pub fn address_of(a0: Int) -> Int
    if a0 < 0 or a0 > 3
        return -1
    0x40 + a0

// ── Register access ──────────────────────────────────────────────────

// The 16-bit register `reg`, or `None` when the part did not answer.
pub fn reg_read<P: Ina3221Port>(p: P, reg: Int) -> ?Int [hw]
    var b: DevBytes = Vec.new()
    if not p.read_regs(reg, 2, var b)
        return None
    Some((b[0] as Int << 8) | b[1] as Int)

// Writes `v` to the 16-bit register `reg`: whether the part acknowledged.
pub fn reg_write<P: Ina3221Port>(p: P, reg: Int, v: Int) -> Bool [hw]
    var src: DevBytes = Vec.new()
    let _ = src.push(((v >> 8) & 0xFF) as u8)
    let _ = src.push((v & 0xFF) as u8)
    p.write_regs(reg, src)

// Writes `v` to the register `reg` and reads it back: whether the part holds
// the bits of `mask`.  The bits outside the mask are status bits or are not
// stored.
pub fn reg_set<P: Ina3221Port>(p: P, reg: Int, v: Int, mask: Int) -> Bool [hw]
    if not reg_write(p, reg, v)
        return false
    match reg_read(p, reg)
        Some(back) => (back & mask) == (v & mask)
        None       => false

// ── Identity ─────────────────────────────────────────────────────────

// The manufacturer ID, which reads 0x5449, or `None` when the part did not
// answer.
pub fn manufacturer_read<P: Ina3221Port>(p: P) -> ?Int [hw]
    reg_read(p, REG_MANUF)

// The die ID, which reads 0x3220, or `None` when the part did not answer.
pub fn die_read<P: Ina3221Port>(p: P) -> ?Int [hw]
    reg_read(p, REG_DIE)

// Whether a manufacturer ID and a die ID are an INA3221's: 0x5449 and
// 0x3220.  The die ID has no revision field.
pub fn id_matches(manufacturer: Int, die: Int) -> Bool
    manufacturer == MANUFACTURER_ID and die == DIE_ID

// The part's identity as a `DeviceId`: the die ID as `who`, no revision;
// `None` when the part did not answer or is not an INA3221.
pub fn id_read<P: Ina3221Port>(p: P) -> ?DeviceId [hw]
    let Some(m) = manufacturer_read(p) else return None
    let Some(d) = die_read(p) else return None
    if not id_matches(m, d)
        return None
    Some(DeviceId { who: d, rev: None })

// ── The configuration ────────────────────────────────────────────────

// The number of averages a CONFIG.AVG code means: 1, 4, 16, 64, 128, 256,
// 512 and 1024 (Table 8-4); 0 for a code outside 0 to 7.
//
// ```novo
// use ina3221
//
// fn main() [io]
//     println("${ina3221.averages_of(3)} ${ina3221.averages_of(7)}")   // 64 1024
// ```
pub fn averages_of(code: Int) -> Int
    if code < 0 or code > 7
        return 0
    if code == 0
        return 1
    if code < 4
        return 1 << (2 * code)
    1 << (code + 3)

// The conversion time a VBUSCT or VSHCT code means, in microseconds: 140,
// 204, 332, 588, 1100, 2116, 4156 and 8244 (Table 8-4); -1 for a code
// outside 0 to 7.
pub fn conversion_time_us(code: Int) -> Int
    if code == 0
        return 140
    if code == 1
        return 204
    if code == 2
        return 332
    if code == 3
        return 588
    if code == 4
        return 1100
    if code == 5
        return 2116
    if code == 6
        return 4156
    if code == 7
        return 8244
    -1

// The bit of CONFIG that enables channel `ch`: bit 14 for channel 0, 13 for
// channel 1 and 12 for channel 2.
fn enable_bit(ch: Int) -> Int
    1 << (14 - ch)

// The fields of a raw CONFIG value.
pub fn config_of(raw: Int) -> Ina3221Config
    Ina3221Config { channels: ((raw >> 14) & 1) | (((raw >> 13) & 1) << 1) | (((raw >> 12) & 1) << 2),
        avg: (raw >> 9) & 7,
        vbus_ct: (raw >> 6) & 7,
        vshunt_ct: (raw >> 3) & 7,
        mode: raw & 7 }

// The CONFIG value for the fields.
pub fn config_bits(c: Ina3221Config) -> Int
    var word = ((c.avg & 7) << 9) | ((c.vbus_ct & 7) << 6) | ((c.vshunt_ct & 7) << 3) | (c.mode & 7)
    for ch in 0..3
        if (c.channels & (1 << ch)) != 0
            word = word | enable_bit(ch)
    word

// Whether a mode converts by itself: 5, 6 and 7.
pub fn mode_is_continuous(mode: Int) -> Bool
    mode >= 5 and mode <= 7

// How many channels a mask enables.
pub fn channel_count(channels: Int) -> Int
    var n = 0
    for ch in 0..3
        if (channels & (1 << ch)) != 0
            n = n + 1
    n

// The time one pass over the enabled channels takes under the configuration,
// in microseconds: the channels times the averages times the conversion
// times of the signals the mode measures; 0 in power-down or with no
// channel enabled.  A field outside its range gives -1.
//
// ```novo
// use ina3221
//
// fn main() [io]
//     // The power-on values: three channels, 1 average, 1.1 ms each signal.
//     let c = ina3221.config_of(0x7127)
//     println("${ina3221.cycle_us(c)}")   // 6600
// ```
pub fn cycle_us(c: Ina3221Config) -> Int
    let n = averages_of(c.avg)
    let tb = conversion_time_us(c.vbus_ct)
    let ts = conversion_time_us(c.vshunt_ct)
    if n == 0 or tb < 0 or ts < 0 or c.mode < 0 or c.mode > 7 or c.channels < 0 or c.channels > 7
        return -1
    let m = c.mode & 3
    let k = channel_count(c.channels)
    if m == 0
        return 0
    if m == 1
        return k * n * ts
    if m == 2
        return k * n * tb
    k * n * (tb + ts)

// The CONFIG register as fields, or `None` when the part did not answer.
pub fn config_read<P: Ina3221Port>(p: P) -> ?Ina3221Config [hw]
    let Some(raw) = reg_read(p, REG_CONFIG) else return None
    Some(config_of(raw))

// Writes the fields to CONFIG and reads them back: whether the part holds
// them.  A field outside its range is refused.  The write halts a
// conversion in progress and starts one from the new settings.
pub fn config_write<P: Ina3221Port>(p: P, c: Ina3221Config) -> Bool [hw]
    if c.channels < 0 or c.channels > 7 or c.avg < 0 or c.avg > 7 or c.vbus_ct < 0 or c.vbus_ct > 7 or c.vshunt_ct < 0 or c.vshunt_ct > 7 or c.mode < 0 or c.mode > 7
        return false
    reg_set(p, REG_CONFIG, config_bits(c), 0x7FFF)

// Sets the channel mask, bit 0 for channel 0, and keeps the other fields.
pub fn channels_write<P: Ina3221Port>(p: P, channels: Int) -> Bool [hw]
    let Some(c) = config_read(p) else return false
    config_write(p, Ina3221Config { channels: channels,
        avg: c.avg,
        vbus_ct: c.vbus_ct,
        vshunt_ct: c.vshunt_ct,
        mode: c.mode })

// Enables or disables one channel and keeps the other fields.  A channel
// outside 0 to 2 is refused without a transaction.
pub fn channel_enable<P: Ina3221Port>(p: P, ch: Int, on: Bool) -> Bool [hw]
    if ch < 0 or ch > 2
        return false
    let Some(c) = config_read(p) else return false
    var mask = c.channels & ~(1 << ch)
    if on
        mask = mask | (1 << ch)
    config_write(p, Ina3221Config { channels: mask,
        avg: c.avg,
        vbus_ct: c.vbus_ct,
        vshunt_ct: c.vshunt_ct,
        mode: c.mode })

// Sets the averaging code, 0 to 7, and keeps the other fields.
pub fn averaging_write<P: Ina3221Port>(p: P, code: Int) -> Bool [hw]
    let Some(c) = config_read(p) else return false
    config_write(p, Ina3221Config { channels: c.channels,
        avg: code,
        vbus_ct: c.vbus_ct,
        vshunt_ct: c.vshunt_ct,
        mode: c.mode })

// Sets the conversion time codes of the bus and shunt voltages, 0 to 7
// each, and keeps the other fields.
pub fn conversion_times_write<P: Ina3221Port>(p: P, vbus_ct: Int, vshunt_ct: Int) -> Bool [hw]
    let Some(c) = config_read(p) else return false
    config_write(p, Ina3221Config { channels: c.channels,
        avg: c.avg,
        vbus_ct: vbus_ct,
        vshunt_ct: vshunt_ct,
        mode: c.mode })

// Sets the operating mode, 0 to 7, and keeps the other fields.
pub fn mode_write<P: Ina3221Port>(p: P, mode: Int) -> Bool [hw]
    let Some(c) = config_read(p) else return false
    config_write(p, Ina3221Config { channels: c.channels,
        avg: c.avg,
        vbus_ct: c.vbus_ct,
        vshunt_ct: c.vshunt_ct,
        mode: mode })

// Resets the part: every register returns to its power-on value.  The
// reset bit clears itself.  Whether the part acknowledged.
pub fn reset<P: Ina3221Port>(p: P) -> Bool [hw]
    reg_write(p, REG_CONFIG, CFG_RST | CONFIG_POR)

// ── Conversions of the registers ─────────────────────────────────────

// The signed number in the upper 13 bits of a shunt, bus or limit register,
// in steps.
fn steps_of(raw: Int) -> Int
    dev_bus.dev_sign_extend(raw >> 3, 13)

// The shunt voltage a register means, in microvolts: 40 uV per step.
//
// ```novo
// use ina3221
//
// fn main() [io]
//     // The sheet's example: -80 mV is 0xC180.
//     println("${ina3221.shunt_uv_of(0xC180)}")   // -80000
// ```
pub fn shunt_uv_of(raw: Int) -> Int
    steps_of(raw) * 40

// The bus voltage a register means, in millivolts: 8 mV per step.
pub fn bus_mv_of(raw: Int) -> Int
    steps_of(raw) * 8

// Whether a shunt register is at either end of its range, where the ADC has
// saturated.
pub fn shunt_saturated(raw: Int) -> Bool
    let s = steps_of(raw)
    s == 4095 or s == -4096

// The sum a SUM register means, in microvolts: the signed number in bits 15
// to 1, 40 uV per step.
pub fn sum_uv_of(raw: Int) -> Int
    dev_bus.dev_sign_extend(raw >> 1, 15) * 40

// The flags of a MASK/ENABLE value.  Channel 0 is CF1 and WF1, at bits 9
// and 5.
pub fn flags_of(raw: Int) -> Ina3221Flags
    var critical = 0
    var warning = 0
    for ch in 0..3
        if (raw & (1 << (9 - ch))) != 0
            critical = critical | (1 << ch)
        if (raw & (1 << (5 - ch))) != 0
            warning = warning | (1 << ch)
    Ina3221Flags { critical: critical, warning: warning, sum: (raw & 0x0040) != 0,
        power_valid: (raw & 0x0004) != 0, timing: (raw & 0x0002) != 0, ready: (raw & 0x0001) != 0 }

// ── Readings ─────────────────────────────────────────────────────────

// The bus voltage of channel `ch` in millivolts, or `None` when the part did
// not answer or the channel is outside 0 to 2.  It needs no shunt.  A
// channel that is disabled holds the voltage of its last conversion.
pub fn bus_read<P: Ina3221Port>(p: P, ch: Int) -> ?MilliVolts [hw]
    if ch < 0 or ch > 2
        return None
    let Some(raw) = reg_read(p, REG_BUS1 + 2 * ch) else return None
    Some(MilliVolts { mv: bus_mv_of(raw) })

// The shunt voltage of channel `ch` in microvolts, or `None`.
pub fn shunt_read<P: Ina3221Port>(p: P, ch: Int) -> ?MicroVolts [hw]
    if ch < 0 or ch > 2
        return None
    let Some(raw) = reg_read(p, REG_SHUNT1 + 2 * ch) else return None
    Some(MicroVolts { uv: shunt_uv_of(raw) })

// The latest measurement of channel `ch` for a shunt of `shunt_micro_ohm`
// micro-ohms: `None` when the part did not answer, the channel is outside 0
// to 2, the resistance is not positive, or the channel is disabled, since a
// disabled channel is not measured and its registers hold an old value.
// With the shunt register at its full scale the shunt voltage is the limit
// of the range, `overflow` is set and the current and power are 0.
pub fn reading_of<P: Ina3221Port>(p: P, ch: Int, shunt_micro_ohm: Int) -> ?MonReading [hw]
    if ch < 0 or ch > 2 or shunt_micro_ohm <= 0
        return None
    let Some(c) = config_read(p) else return None
    if (c.channels & (1 << ch)) == 0
        return None
    let Some(shunt) = reg_read(p, REG_SHUNT1 + 2 * ch) else return None
    let Some(bus) = reg_read(p, REG_BUS1 + 2 * ch) else return None
    let v = MicroVolts { uv: shunt_uv_of(shunt) }
    let b = MilliVolts { mv: bus_mv_of(bus) }
    if shunt_saturated(shunt)
        return Some(MonReading { bus: b, shunt: v, current: MicroAmps { ua: 0 }, power: MicroWatts { uw: 0 },
                                 overflow: true })
    let i = dev_current.mon_current(v, shunt_micro_ohm)
    Some(MonReading { bus: b, shunt: v, current: i, power: dev_current.mon_power(b, i), overflow: false })

// Starts a triggered conversion of every enabled channel, the shunt and the
// bus voltage, and answers the time it takes in microseconds, to be waited
// before the result is read.  A part in a continuous mode converts by itself,
// so nothing is written and the answer is 0.  With no channel enabled there
// is nothing to convert, and the answer is -1, as it is when the part did not
// answer.  The averaging and conversion times are kept.
pub fn convert_start<P: Ina3221Port>(p: P) -> Int [hw]
    let Some(c) = config_read(p) else return -1
    if mode_is_continuous(c.mode)
        return 0
    if c.channels == 0
        return -1
    let t = Ina3221Config { channels: c.channels, avg: c.avg, vbus_ct: c.vbus_ct, vshunt_ct: c.vshunt_ct,
        mode: MODE_BOTH_TRIGGERED }
    if not config_write(p, t)
        return -1
    cycle_us(t)

// Whether a conversion has finished: the Conversion Ready flag.  Reading it
// clears it.
pub fn conversion_ready<P: Ina3221Port>(p: P) -> Bool [hw]
    match reg_read(p, REG_MASK)
        Some(m) => (m & 0x0001) != 0
        None    => false

// ── The alerts ───────────────────────────────────────────────────────

// Whether a limit in microvolts fits the 13-bit signed field of a shunt
// limit register: -163840 to 163800.
pub fn shunt_limit_fits(uv: Int) -> Bool
    uv >= SHUNT_FLOOR_UV and uv <= SHUNT_FULL_SCALE_UV

// The raw critical or warning limit for `uv` microvolts across the shunt: 40
// uV per step in bits 15 to 3, rounded toward zero.
pub fn shunt_limit_raw(uv: Int) -> Int
    ((uv / 40) << 3) & 0xFFF8

// The raw shunt-voltage sum limit for `uv` microvolts: 40 uV per step in bits
// 15 to 1.
pub fn sum_limit_raw(uv: Int) -> Int
    ((uv / 40) << 1) & 0xFFFE

// Whether a sum limit fits the 15-bit signed field of the sum registers:
// -655360 to 655320 microvolts.
pub fn sum_limit_fits(uv: Int) -> Bool
    uv >= -655360 and uv <= 655320

// The raw power-valid limit for `mv` millivolts: 8 mV per step in bits 14 to
// 3, rounded toward zero.
pub fn pv_limit_raw(mv: Int) -> Int
    ((mv / 8) << 3) & 0x7FF8

// Whether a power-valid limit fits the 12-bit field: 0 to 32760 millivolts.
pub fn pv_limit_fits(mv: Int) -> Bool
    mv >= 0 and mv <= 32760

// Writes the critical limit of channel `ch` in microvolts across the shunt:
// the alert fires when one conversion of the shunt voltage exceeds it.  A
// limit outside the register's range and a channel outside 0 to 2 are
// refused.  Whether the part holds the value.
pub fn critical_write<P: Ina3221Port>(p: P, ch: Int, uv: Int) -> Bool [hw]
    if ch < 0 or ch > 2 or not shunt_limit_fits(uv)
        return false
    reg_set(p, REG_CRIT1 + 2 * ch, shunt_limit_raw(uv), 0xFFF8)

// Writes the warning limit of channel `ch`: the alert fires when the averaged
// shunt voltage exceeds it.  Refusals as `critical_write`.
pub fn warning_write<P: Ina3221Port>(p: P, ch: Int, uv: Int) -> Bool [hw]
    if ch < 0 or ch > 2 or not shunt_limit_fits(uv)
        return false
    reg_set(p, REG_WARN1 + 2 * ch, shunt_limit_raw(uv), 0xFFF8)

// The critical limit of channel `ch` in microvolts, or `None`.
pub fn critical_read<P: Ina3221Port>(p: P, ch: Int) -> ?MicroVolts [hw]
    if ch < 0 or ch > 2
        return None
    let Some(raw) = reg_read(p, REG_CRIT1 + 2 * ch) else return None
    Some(MicroVolts { uv: shunt_uv_of(raw) })

// The warning limit of channel `ch` in microvolts, or `None`.
pub fn warning_read<P: Ina3221Port>(p: P, ch: Int) -> ?MicroVolts [hw]
    if ch < 0 or ch > 2
        return None
    let Some(raw) = reg_read(p, REG_WARN1 + 2 * ch) else return None
    Some(MicroVolts { uv: shunt_uv_of(raw) })

// The sum of the shunt voltages of the channels the alert configuration
// picked, in microvolts, or `None`.
pub fn sum_read<P: Ina3221Port>(p: P) -> ?MicroVolts [hw]
    let Some(raw) = reg_read(p, REG_SUM) else return None
    Some(MicroVolts { uv: sum_uv_of(raw) })

// Writes the limit of the sum register in microvolts.  A limit outside the
// register's range is refused.  Whether the part holds the value.
pub fn sum_limit_write<P: Ina3221Port>(p: P, uv: Int) -> Bool [hw]
    if not sum_limit_fits(uv)
        return false
    reg_set(p, REG_SUM_LIMIT, sum_limit_raw(uv), 0xFFFE)

// Writes the power-valid limits in millivolts: the PV pin goes high when
// every enabled bus voltage is above `upper_mv` and low again when one falls
// below `lower_mv`.  The lower limit has to be at most the upper.  A limit
// outside 0 to 32760 is refused.  Whether the part holds both values.  A
// software reset restores the sheet's 10 V and 9 V (Section 7.3.3).
pub fn pv_write<P: Ina3221Port>(p: P, upper_mv: Int, lower_mv: Int) -> Bool [hw]
    if not pv_limit_fits(upper_mv) or not pv_limit_fits(lower_mv) or lower_mv > upper_mv
        return false
    if not reg_set(p, REG_PV_UPPER, pv_limit_raw(upper_mv), 0x7FF8)
        return false
    reg_set(p, REG_PV_LOWER, pv_limit_raw(lower_mv), 0x7FF8)

// The power-valid upper limit in millivolts, or `None`.
pub fn pv_upper_read<P: Ina3221Port>(p: P) -> ?MilliVolts [hw]
    let Some(raw) = reg_read(p, REG_PV_UPPER) else return None
    Some(MilliVolts { mv: bus_mv_of(raw) })

// The power-valid lower limit in millivolts, or `None`.
pub fn pv_lower_read<P: Ina3221Port>(p: P) -> ?MilliVolts [hw]
    let Some(raw) = reg_read(p, REG_PV_LOWER) else return None
    Some(MilliVolts { mv: bus_mv_of(raw) })

// The MASK/ENABLE value for an alert configuration: SCC1 to SCC3 at bits 14
// to 12, WEN and CEN.  The flag bits are written as 0.
pub fn alert_bits(a: Ina3221Alert) -> Int
    var word = 0
    for ch in 0..3
        if (a.sum_channels & (1 << ch)) != 0
            word = word | (1 << (14 - ch))
    if a.warning_latch
        word = word | ME_WEN
    if a.critical_latch
        word = word | ME_CEN
    word

// Writes the summation channels and the two latch bits to MASK/ENABLE and
// reads them back: whether the part holds them.  A channel mask outside 0 to
// 7 is refused.  The write does not clear the flags (Section 8.2.16).
pub fn alert_write<P: Ina3221Port>(p: P, a: Ina3221Alert) -> Bool [hw]
    if a.sum_channels < 0 or a.sum_channels > 7
        return false
    reg_set(p, REG_MASK, alert_bits(a), ME_CONFIG_MASK)

// MASK/ENABLE as flags, or `None` when the part did not answer.  Reading it
// clears the flags and Conversion Ready.
pub fn flags_read<P: Ina3221Port>(p: P) -> ?Ina3221Flags [hw]
    let Some(m) = reg_read(p, REG_MASK) else return None
    Some(flags_of(m))

// ── Bring-up ─────────────────────────────────────────────────────────

// Brings the part up: the bus made ready, the manufacturer and die ID
// checked, the part reset and CONFIG checked against its power-on value.
// Answers whether the part answered as an INA3221.  All three channels are
// enabled after it, converting continuously.
pub fn start<P: Ina3221Port>(p: P) -> Bool [hw]
    if not p.setup()
        return false
    if id_read(p) == None
        return false
    if not reset(p)
        return false
    reg_read(p, REG_CONFIG) == Some(CONFIG_POR)

// ── The part on the board's I2C bus ──────────────────────────────────

// The bus the part is on: the board's I2C bus at `w.addr`, 0x40 to 0x43, and
// the board's GPIO for the Critical pin.
pub @value
struct Ina3221I2c
    bus: BoardI2c
    pins: BoardGpio
    w: DeviceWiring

impl Ina3221Port for Ina3221I2c
    fn setup(self) -> Bool [hw]
        i2c_setup(self.bus, self.pins, self.w)

    fn read_regs(self, reg: Int, n: Int, var dst: DevBytes) -> Bool [hw]
        i2c_read_into(self.bus, self.w, reg, n, var dst)

    fn write_regs(self, reg: Int, src: DevBytes) -> Bool [hw]
        i2c_write(self.bus, self.w, reg, src)

    fn alert_level(self) -> Int [hw]
        alert_level_of(self.pins, self.w)

// An INA3221 on a board's I2C bus, with the shunt resistor of each of its
// three channels, in micro-ohms.  A resistance that is not positive marks a
// channel the board does not use.
pub @value
struct Ina3221
    port: Ina3221I2c
    shunt0: Int
    shunt1: Int
    shunt2: Int

// The resistance of channel `ch`, or 0 for a channel outside 0 to 2.
pub fn shunt_of(s0: Int, s1: Int, s2: Int, ch: Int) -> Int
    if ch == 0
        return s0
    if ch == 1
        return s1
    if ch == 2
        return s2
    0

// Takes the shunt of channel `ch` into use for the `CurrentMonitor`: the
// channel is enabled, and the resistance has to be the one the board was
// attached with (`s0`, `s1` and `s2`), since a different one would make every
// current wrong.  A shunt that would drop more than 163.8 mV at the largest
// current, a resistance that is not positive and a channel outside 0 to 2 are
// refused without a transaction.  The part has no calibration, so nothing
// else is written.
pub fn shunt_set<P: Ina3221Port>(p: P, s0: Int, s1: Int, s2: Int, ch: Int, shunt_micro_ohm: Int,
                                 max_ua: Int) -> Bool [hw]
    if ch < 0 or ch > 2 or shunt_micro_ohm <= 0 or shunt_micro_ohm != shunt_of(s0, s1, s2, ch)
        return false
    if not dev_current.mon_shunt_fits(shunt_micro_ohm, max_ua, SHUNT_FULL_SCALE_UV)
        return false
    channel_enable(p, ch, true)

impl Ina3221
    // The part at `w.addr` on the board's I2C bus, with the board's shunt
    // resistors of `shunt0`, `shunt1` and `shunt2` micro-ohms for channels
    // 0 to 2 (a 0.1 ohm shunt is 100000), as a board's device table builds
    // it.  Nothing is sent.
    fn attach(bus: BoardI2c, pins: BoardGpio, w: DeviceWiring, shunt0: Int, shunt1: Int,
              shunt2: Int) -> Ina3221
        Ina3221 { port: Ina3221I2c { bus: bus, pins: pins, w: w },
            shunt0: shunt0,
            shunt1: shunt1,
            shunt2: shunt2 }

    // Brings the part up (`start`).
    fn begin(self) -> Bool [hw]
        start(self.port)

    // The shunt resistance of channel `ch` in micro-ohms, 0 for a channel
    // the board does not use or one outside 0 to 2.
    fn shunt(self, ch: Int) -> Int
        shunt_of(self.shunt0, self.shunt1, self.shunt2, ch)

    // The register `r`, 16 bits, `None` when the part did not answer.
    fn reg(self, r: Int) -> ?Int [hw]
        reg_read(self.port, r)

    // The shunt voltage of channel `ch`.
    fn shunt_voltage(self, ch: Int) -> ?MicroVolts [hw]
        shunt_read(self.port, ch)

    // MASK/ENABLE as flags; reading it clears the flags.
    fn flags(self) -> ?Ina3221Flags [hw]
        flags_read(self.port)

    // Whether a conversion has finished.
    fn ready(self) -> Bool [hw]
        conversion_ready(self.port)

    // The CONFIG fields.
    fn config(self) -> ?Ina3221Config [hw]
        config_read(self.port)

    // Writes the CONFIG fields.
    fn set_config(self, c: Ina3221Config) -> Bool [hw]
        config_write(self.port, c)

    // Enables or disables one channel.
    fn set_channel(self, ch: Int, on: Bool) -> Bool [hw]
        channel_enable(self.port, ch, on)

    // Sets the averaging code, 0 to 7.
    fn set_averaging(self, code: Int) -> Bool [hw]
        averaging_write(self.port, code)

    // Sets the conversion time codes of the bus and shunt voltages.
    fn set_conversion_times(self, vbus_ct: Int, vshunt_ct: Int) -> Bool [hw]
        conversion_times_write(self.port, vbus_ct, vshunt_ct)

    // Sets the operating mode, 0 to 7.
    fn set_mode(self, mode: Int) -> Bool [hw]
        mode_write(self.port, mode)

    // Sets the critical limit of a channel in microvolts across its shunt.
    fn set_critical(self, ch: Int, uv: Int) -> Bool [hw]
        critical_write(self.port, ch, uv)

    // Sets the warning limit of a channel in microvolts across its shunt.
    fn set_warning(self, ch: Int, uv: Int) -> Bool [hw]
        warning_write(self.port, ch, uv)

    // The critical limit of a channel.
    fn critical(self, ch: Int) -> ?MicroVolts [hw]
        critical_read(self.port, ch)

    // The warning limit of a channel.
    fn warning(self, ch: Int) -> ?MicroVolts [hw]
        warning_read(self.port, ch)

    // The shunt-voltage sum and its limit.
    fn sum(self) -> ?MicroVolts [hw]
        sum_read(self.port)

    fn set_sum_limit(self, uv: Int) -> Bool [hw]
        sum_limit_write(self.port, uv)

    // Picks the summed channels and the latching of the alerts.
    fn set_alert(self, a: Ina3221Alert) -> Bool [hw]
        alert_write(self.port, a)

    // The power-valid limits in millivolts.
    fn set_power_valid(self, upper_mv: Int, lower_mv: Int) -> Bool [hw]
        pv_write(self.port, upper_mv, lower_mv)

    fn power_valid_upper(self) -> ?MilliVolts [hw]
        pv_upper_read(self.port)

    fn power_valid_lower(self) -> ?MilliVolts [hw]
        pv_lower_read(self.port)

    // The level of the Critical pin, -1 for a wiring with none.
    fn alert_pin(self) -> Int [hw]
        self.port.alert_level()

impl CurrentMonitor[hw] for Ina3221
    // Three rails.
    fn mon_channels(self) -> Int [hw]
        3

    // Takes the shunt of a channel into use (`shunt_set`).
    fn mon_set_shunt(self, ch: Int, shunt_micro_ohm: Int, max_ua: Int) -> Bool [hw]
        shunt_set(self.port, self.shunt0, self.shunt1, self.shunt2, ch, shunt_micro_ohm, max_ua)

    // The measurement of a channel, or `None` for a channel the board does
    // not use or that is disabled.
    fn mon_read(self, ch: Int) -> ?MonReading [hw]
        reading_of(self.port, ch, shunt_of(self.shunt0, self.shunt1, self.shunt2, ch))

    // The bus voltage of a channel, which needs no shunt.
    fn mon_bus_voltage(self, ch: Int) -> ?MilliVolts [hw]
        bus_read(self.port, ch)

    // Starts a triggered conversion of the enabled channels and answers its
    // time in microseconds, 0 in a continuous mode, -1 with no channel
    // enabled or when the part did not answer.
    fn mon_start(self) -> Int [hw]
        convert_start(self.port)

impl Identifiable[hw] for Ina3221
    // The die ID, 0x3220, after the manufacturer ID matched 0x5449.
    fn device_id(self) -> ?DeviceId [hw]
        id_read(self.port)
